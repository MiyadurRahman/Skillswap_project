rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester one of the two participants?
    function isRequesterParticipant(resData) {
      return resData.requester.uid == request.auth.uid;
    }
    function isMentorParticipant(resData) {
      return resData.mentor.uid == request.auth.uid;
    }

    // ---- User profiles ------------------------------------------------
    // Any authenticated scholar can read the directory so people can find
    // each other; only the owner of a profile can create/update it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Session requests ---------------------------------------------
    // One doc per request; only the requester and the mentor can see or
    // modify it. A requester is only allowed to create a pending request.
    match /requests/{requestId} {
      allow read: if request.auth != null &&
        (isRequesterParticipant(resource.data) || isMentorParticipant(resource.data));
      allow create: if request.auth != null &&
        isRequesterParticipant(request.resource.data) &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
        (isRequesterParticipant(resource.data) || isMentorParticipant(resource.data));
      allow delete: if false;
    }

    // ---- Sessions -----------------------------------------------------
    // Created when a request is accepted; only participants can read/update.
    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.status == 'Accepted';
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }
  }
}