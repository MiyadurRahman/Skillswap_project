rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ------------------------------------------------
    function isRequester(resData, auth) {
      return resData.requester.uid == auth.uid;
    }
    function isMentor(resData, auth) {
      return resData.mentor.uid == auth.uid;
    }
    function profileFieldsOnly(requestData, currentData) {
      return requestData.diff(currentData).affectedKeys().hasOnly([
        'name', 'title', 'academicLevel', 'university', 'bio',
        'avatarUrl', 'expertiseAreas', 'learningGoals', 'skillsTeach',
        'skillsWant', 'availability', 'preferredMode', 'isOnline',
        'lastActiveAt', 'updatedAt', 'uid'
      ]);
    }
    function validInitialStats(data) {
      return data.get('timeCredits', 0) == 0 &&
        data.get('creditsEarned', 0) == 0 &&
        data.get('creditsSpent', 0) == 0 &&
        data.get('completedSwaps', 0) == 0 &&
        data.get('ratingCount', 0) == 0 &&
        data.get('ratingSum', 0) == 0 &&
        data.get('ratingAverage', 0) == 0 &&
        data.get('achievementBadges', []).size() == 0;
    }
    // Top-level keys that a write would add / change / delete.
    function changedKeys(requestData, currentData) {
      return requestData.diff(currentData).affectedKeys();
    }
    function validSettlementProfileUpdate(uid, requestData, currentData) {
      let sessionId = requestData.get('lastSettlementId', '');
      let session = getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
      let isRequester = session.requester.uid == uid;
      let ledgerId = isRequester ? sessionId + '__spent' : sessionId + '__earned';
      let ledger = getAfter(/databases/$(database)/documents/transactions/$(ledgerId)).data;
      let amount = session.creditAmount;
      return request.auth != null &&
        request.auth.uid in session.participantIds &&
        uid in session.participantIds &&
        session.status == 'Completed' &&
        session.statsApplied == true &&
        amount is number && amount > 0 &&
        currentData.get('lastSettlementId', '') != sessionId &&
        !exists(/databases/$(database)/documents/transactions/$(ledgerId)) &&
        ledger.uid == uid && ledger.sessionId == sessionId &&
        changedKeys(requestData, currentData).hasOnly([
          'timeCredits', 'creditsEarned', 'creditsSpent', 'completedSwaps',
          'lastSettlementId', 'updatedAt'
        ]) &&
        requestData.completedSwaps == currentData.get('completedSwaps', 0) + 1 &&
        ((isRequester &&
          requestData.timeCredits == currentData.get('timeCredits', 0) - amount &&
          requestData.timeCredits >= 0 &&
          requestData.creditsSpent == currentData.get('creditsSpent', 0) + amount &&
          requestData.get('creditsEarned', 0) == currentData.get('creditsEarned', 0)) ||
        (!isRequester && session.mentor.uid == uid &&
          requestData.timeCredits == currentData.get('timeCredits', 0) + amount &&
          requestData.creditsEarned == currentData.get('creditsEarned', 0) + amount &&
          requestData.get('creditsSpent', 0) == currentData.get('creditsSpent', 0)));
    }
    function validRatingProfileUpdate(uid, requestData, currentData) {
      let reviewId = requestData.get('lastRatingReviewId', '');
      let review = getAfter(/databases/$(database)/documents/reviews/$(reviewId)).data;
      let nextCount = currentData.get('ratingCount', 0) + 1;
      let nextSum = currentData.get('ratingSum', 0) + review.rating;
      return request.auth != null &&
        review.authorUid == request.auth.uid && review.targetUid == uid &&
        !exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        changedKeys(requestData, currentData).hasOnly([
          'ratingCount', 'ratingSum', 'ratingAverage',
          'lastRatingReviewId', 'updatedAt'
        ]) &&
        requestData.ratingCount == nextCount &&
        requestData.ratingSum == nextSum &&
        requestData.ratingAverage == nextSum / nextCount;
    }

    // ---- User profiles --------------------------------------------------
    // Any authenticated scholar can read the directory so people can find
    // each other; only the owner of a profile can create/update it.
    // NOTE: this exposes every user's full profile (including email if stored)
    // to any authenticated user. If that is unacceptable, split public fields
    // from private ones (e.g. users/{uid}/private) instead of locking the
    // directory, which the Discover/session features depend on.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        validInitialStats(request.resource.data);
      // Owners can edit their own profile; additionally, a rating bump (a
      // positive increment to ratingCount/ratingSum only) is allowed by any
      // authenticated user — this is what a review submission uses.
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        profileFieldsOnly(request.resource.data, resource.data) ||
        validSettlementProfileUpdate(uid, request.resource.data, resource.data) ||
        validRatingProfileUpdate(uid, request.resource.data, resource.data) ||
        (request.auth.token.admin == true &&
          changedKeys(request.resource.data, resource.data).hasOnly(['timeCredits', 'updatedAt']) &&
          request.resource.data.timeCredits >= 0);
      allow delete: if false;
    }

    // ---- Time-credit ledger -----------------------------------------------
    // Each transaction belongs to exactly one user and is immutable. Users can
    // only ever read their own entries and can never forge or alter a ledger
    // that isn't theirs.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && (
        (request.auth.token.admin == true &&
          request.resource.data.type == 'adjustment' &&
          request.resource.data.adjustedBy == request.auth.uid) ||
        (request.resource.data.sessionId is string &&
          request.auth.uid in getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participantIds &&
          getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'Completed' &&
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.lastSettlementId == request.resource.data.sessionId &&
          ((request.resource.data.type == 'spent' &&
            transactionId == request.resource.data.sessionId + '__spent' &&
            request.resource.data.uid == getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.requester.uid &&
            request.resource.data.amount == -getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.creditAmount) ||
          (request.resource.data.type == 'earned' &&
            transactionId == request.resource.data.sessionId + '__earned' &&
            request.resource.data.uid == getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.mentor.uid &&
            request.resource.data.amount == getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.creditAmount)))
      );
      allow update: if false;
      allow delete: if false;
    }

    // ---- Reviews -----------------------------------------------------------
    // Any authenticated scholar can read reviews (they're displayed on public
    // profiles). A review can only be created once per (session, author), for
    // a completed session the author actually participated in, rating 1-5.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        reviewId == request.resource.data.sessionId + '__' + request.auth.uid &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.auth.uid in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participantIds &&
        request.resource.data.targetUid in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participantIds &&
        get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'Completed' &&
        getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data.lastRatingReviewId == reviewId;
      allow update: if false;
      allow delete: if false;
    }

    // ---- Session requests ------------------------------------------------
    // One doc per request. Only the requester or mentor can see it. Creates
    // are pending-only and cannot self-target the current user as the mentor.
    // Updates are restricted to the exact transitions the app performs, with
    // a whitelist of fields each side may touch:
    //   requester: pending -> cancelled
    //              rescheduled -> pending (confirm proposed alternate time)
    //   mentor:    pending -> accepted / declined / rescheduled
    match /requests/{requestId} {
      allow read: if request.auth != null &&
        (isRequester(resource.data, request.auth) || isMentor(resource.data, request.auth));
      allow create: if request.auth != null &&
        isRequester(request.resource.data, request.auth) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.mentor.uid != request.resource.data.requester.uid;
      allow update: if request.auth != null && (
        // Requester cancels their pending request.
        (isRequester(resource.data, request.auth) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          changedKeys(request.resource.data, resource.data).hasOnly(['status', 'respondedAt'])) ||
        // Requester confirms the mentor's proposed alternate time (reopens
        // the request as pending with the new date/slot).
        (isRequester(resource.data, request.auth) &&
          resource.data.status == 'rescheduled' &&
          request.resource.data.status == 'pending' &&
          changedKeys(request.resource.data, resource.data).hasOnly([
            'status', 'preferredDate', 'formattedDate', 'preferredTimeSlot',
            'rescheduledDate', 'rescheduledSlot', 'rescheduleNote', 'respondedAt',
          ])) ||
        // Mentor accepts a pending request (session is created in same batch).
        (isMentor(resource.data, request.auth) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          changedKeys(request.resource.data, resource.data).hasOnly([
            'status', 'respondedAt', 'responseNote', 'linkedSessionId',
          ])) ||
        // Mentor declines a pending request.
        (isMentor(resource.data, request.auth) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'declined' &&
          changedKeys(request.resource.data, resource.data).hasOnly([
            'status', 'respondedAt', 'declineReason',
          ])) ||
        // Mentor proposes an alternate time for a pending request.
        (isMentor(resource.data, request.auth) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'rescheduled' &&
          changedKeys(request.resource.data, resource.data).hasOnly([
            'status', 'respondedAt', 'rescheduledDate', 'rescheduledSlot',
            'rescheduleNote',
          ]))
      );
      allow delete: if false;
    }

    // ---- Sessions ---------------------------------------------------------
    // Created when a request is accepted; only participants can read/update.
    // Create is restricted so a user cannot fabricate a session involving an
    // arbitrary third party: status must be Accepted, the participant list
    // must be exactly the two distinct participants, and the creator must be
    // one of them.
    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.status == 'Accepted' &&
        request.resource.data.originRequestId is string &&
        request.resource.data.creditAmount is number &&
        request.resource.data.creditAmount > 0 &&
        request.resource.data.meetingLink is string &&
        request.resource.data.meetingLink.matches('https?://.+') &&
        request.resource.data.requester.uid != null &&
        request.resource.data.mentor.uid != null &&
        request.resource.data.requester.uid != request.resource.data.mentor.uid &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.requester.uid,
          request.resource.data.mentor.uid
        ]) &&
        request.resource.data.participantIds.size() == 2 &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.originRequestId)).data.status == 'accepted' &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.originRequestId)).data.linkedSessionId == sessionId &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.originRequestId)).data.requester.uid == request.resource.data.requester.uid &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.originRequestId)).data.mentor.uid == request.resource.data.mentor.uid;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        request.auth.uid in request.resource.data.participantIds &&
        // Participants may not swap the partner or add/remove anyone.
        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
        resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
        (
          changedKeys(request.resource.data, resource.data).hasOnly([
            'title', 'date', 'time', 'startAt', 'endAt', 'notes', 'meetingLink'
          ]) ||
          (resource.data.status == 'Accepted' &&
            request.resource.data.status == 'Accepted' &&
            changedKeys(request.resource.data, resource.data).hasOnly(['settledBy']) &&
            request.resource.data.settledBy.diff(resource.data.get('settledBy', {})).affectedKeys().hasOnly([request.auth.uid])) ||
          (resource.data.status == 'Accepted' &&
            request.resource.data.status == 'Completed' &&
            request.resource.data.statsApplied == true &&
            request.resource.data.settledBy[request.resource.data.requester.uid] != null &&
            request.resource.data.settledBy[request.resource.data.mentor.uid] != null &&
            request.resource.data.settledBy.diff(resource.data.get('settledBy', {})).affectedKeys().hasOnly([request.auth.uid]) &&
            changedKeys(request.resource.data, resource.data).hasOnly([
              'settledBy', 'status', 'completedAt', 'statsApplied'
            ]) &&
            getAfter(/databases/$(database)/documents/transactions/$(sessionId + '__spent')).data.sessionId == sessionId &&
            getAfter(/databases/$(database)/documents/transactions/$(sessionId + '__earned')).data.sessionId == sessionId)
        );
      allow delete: if false;
    }

    // ---- Conversations (1:1 chat) ----------------------------------------
    // One doc per user pair; only the two participants can interact. Creates
    // require exactly two distinct participant ids (no victim injection).
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.removeAll([request.auth.uid]).size() == 1;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        request.auth.uid in request.resource.data.participantIds &&
        // No participant set mutation after creation.
        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
        resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
        changedKeys(request.resource.data, resource.data).hasOnly([
          'lastText', 'lastFrom', 'lastFromName', 'updatedAt', 'unread',
        ]);
      allow delete: if false;

      // Messages are restricted to participants; only the sender can create.
      match /messages/{messageId} {
        // Authorize reads from the parent conversation. A collection query
        // cannot prove that every child document's participantIds contains the
        // caller, so checking resource.data here causes valid listeners to be
        // rejected with permission-denied.
        allow read: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid in request.resource.data.participantIds &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.participantIds.hasAll(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          ) &&
          getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAll(
            request.resource.data.participantIds
          );
        allow update: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          changedKeys(request.resource.data, resource.data).hasOnly(['read']);
        allow delete: if false;
      }
    }
  }
}
