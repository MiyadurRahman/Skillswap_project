# Optional local Firebase project. Copy this file to .env.local and replace
# every value with the web-app configuration from a non-production project.
VITE_FIREBASE_API_KEY=replace-with-development-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-development-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-development-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-development-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-development-sender-id
VITE_FIREBASE_APP_ID=replace-with-development-app-id
